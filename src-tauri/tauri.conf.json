{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrainDump Lite",
  "version": "0.6.0",
  "identifier": "com.canyonwirthlin.braindumplite",
  "build": {
    "frontendDist": "../shell-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BrainDump Lite",
        "url": "index.html",
        "width": 1100,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "backend/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBQjBEMzhEN0MxMThGNDgKUldSSWp4RjhqZE93bXJaVzhpdk5haCtoRkdPWXBraWtUWmtIa3lUUUZjQy9OR0h3Q042cm1oaGQK",
      "endpoints": [
        "https://github.com/canyonwirthlin/BrainDumpLite/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
